{
  "expo": {
    "name": "FitCoach Pro",
    "slug": "fitcoach-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fitcoachpro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EDE1C9"
    },
    "ios": {
      "bundleIdentifier": "com.fitcoachpro.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCalendarsUsageDescription": "FitCoach precisa acessar sua agenda para sincronizar aulas.",
        "NSCalendarsFullAccessUsageDescription": "FitCoach precisa acessar sua agenda para criar e remover aulas."
      }
    },
    "plugins": [
      [
        "expo-calendar",
        {
          "calendarPermission": "FitCoach precisa acessar sua agenda para sincronizar aulas."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C2410C"
        }
      ],
      [
        "expo-secure-store"
      ],
      "expo-asset"
    ],
    "extra": {
      "supabaseUrl": "${EXPO_PUBLIC_SUPABASE_URL}",
      "supabaseAnonKey": "${EXPO_PUBLIC_SUPABASE_ANON_KEY}"
    }
  }
}
